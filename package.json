{
  "name": "stacklens",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that identifies the technologies a website is built with.",
  "type": "module",
  "scripts": {
    "build": "npm run icons:map && tsc --noEmit && vite build",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons:map": "node scripts/make-icons-map.mjs",
    "test:e2e": "npm run build && node tests/e2e/run.mjs",
    "verify": "npm run test && npm run test:e2e",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.28",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "simple-icons": "^16.27.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
